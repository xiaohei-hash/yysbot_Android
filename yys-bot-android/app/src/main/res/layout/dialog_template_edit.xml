<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:background="#f0f0f0"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <android.widget.CheckBox
            android:id="@+id/cbEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="启用此模板"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="匹配模式"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbImageRecognition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 图像识别"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbFixedPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 固定坐标" />
        </RadioGroup>

        <!-- 固定坐标/范围输入区域（仅 FIXED_POSITION 模式显示） -->
        <LinearLayout
            android:id="@+id/llFixedPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/etFixedX"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="左上 X"
                    android:inputType="number"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etFixedY"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="左上 Y"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etFixedW"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="范围宽（0=单点）"
                    android:inputType="number"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etFixedH"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="范围高（0=单点）"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRegionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="12sp"
            android:textColor="#666"
            android:gravity="center"
            android:visibility="gone"
            android:text="范围模式下将在矩形范围内随机点击，宽高为 0 则点击单点" />

        <Button
            android:id="@+id/btnRecordPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 标定坐标 / 框选范围"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llImageRecognitionSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etConfidence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="匹配阈值 (0.01-1.0)"
                android:inputType="numberDecimal"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etDetectConfidence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="扫描阈值 (0.01-1.0)"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖼 从相册替换图片"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 拍照替换图片"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="↩ 重置为内置默认"
            android:visibility="gone"
            android:backgroundTint="#FF9800" />

    </LinearLayout>
</ScrollView>